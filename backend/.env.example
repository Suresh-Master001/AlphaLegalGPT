JWT_SECRET=your-super-secret-jwt-key-change-in-production-1234567890
GEMINI_API_KEY=your-gemini-api-key
FRONTEND_URL=http://localhost:5173
# Email Configuration (choose one)

# Option A: Brevo SMTP (recommended for Render/Cloud - free 300 emails/day)
# Get SMTP key from: https://brevo.com -> Settings -> SMTP & API
BREVO_SMTP_KEY=your-brevo-smtp-key
EMAIL_USER=your-verified-sender@domain.com

# Option B: Gmail SMTP (may have connectivity issues on Render)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SERVICE=gmail
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/alphalegalgpt
# For MongoDB Atlas use: mongodb+srv://username:password@cluster.mongodb.net/alphalegalgpt?retryWrites=true&w=majority
ALLOWED_ORIGINS=http://localhost:5173,https://alphalegalgpt.vercel.app